<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MantosExtract — CorelDRAW add-in that extracts artwork elements from a real garment photo
    via server-side OpenAI (mantosfc), upscales locally, and imports the result into the
    document. Same shim shape as SisCut/Optimus/AiSten (net48 + WebView2 docker), scaffolded
    directly from Optimus.AddIn.csproj per the spec's own instruction (docs/mantos-extract-spec.md §0.1).

    net48 is the framework the CorelDRAW addon host loads. Works across CorelDRAW 2024/25/26 by
    LATE-BINDING the Application (dynamic) — one assembly, every version.

    No ILRepack in dev: every managed dep ships loose next to MantosExtract.AddIn.dll in the
    addon folder, and MantosExtractDocker's AssemblyResolve loads each sibling from that folder
    (the CorelDRAW host does NOT add the addon folder to the probe path). ILRepack is a Fase 5
    installer concern (see plans/Phase_5.md).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>MantosExtract.AddIn</RootNamespace>
    <AssemblyName>MantosExtract.AddIn</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Cross-platform net48 reference assemblies so the source compiles anywhere. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- WebView2 hosts the operator UI (Ui/MantosExtractDocker.cs) in-process inside CorelDRAW. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- Layers: Core is pure (testable on net8.0), Interop owns every CorelDRAW COM call,
       Windows owns DPAPI/prefs. -->
  <ItemGroup>
    <ProjectReference Include="..\MantosExtract.Core\MantosExtract.Core.csproj" />
    <ProjectReference Include="..\MantosExtract.Interop\MantosExtract.Interop.csproj" />
    <ProjectReference Include="..\MantosExtract.Windows\MantosExtract.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
    <!-- WPF: the docker control is a System.Windows.Controls.UserControl (the addon framework
         hosts only WPF, type="wpfhost"). Built in code, no XAML. -->
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <!-- Operator UI (single self-contained HTML file, CSS inline, fully offline). Embedded in
       the DLL; MantosExtractBridge extracts it to %TEMP%\MantosExtract_ui\ and serves it
       through a WebView2 virtual host. -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot/index.html">
      <LogicalName>ui.index.html</LogicalName>
    </EmbeddedResource>
    <!-- Login screen background loop (Swiss Style hard-edged glassmorphism, Dave 2026-09-04).
         Extracted alongside index.html by MantosExtractBridge.ExtractUi() into the SAME temp
         folder, so a plain relative <video src="loop.mp4"> in the HTML resolves against the
         "mantosextract.app" virtual host with zero network dependency. -->
    <EmbeddedResource Include="wwwroot/loop.mp4">
      <LogicalName>ui.loop.mp4</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
