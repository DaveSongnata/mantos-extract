<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for MantosExtract.Core. net8.0 so they run anywhere (no CorelDRAW, no Windows-only
    deps, no WebView2). Everything COM/Win32/WPF is excluded by construction: Core has no such
    references, so if a test needs CorelDRAW or DPAPI to pass, the logic is in the wrong
    project.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>MantosExtract.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MantosExtract.Core\MantosExtract.Core.csproj" />
  </ItemGroup>

</Project>
